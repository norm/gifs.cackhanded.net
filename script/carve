#!/usr/bin/env -S bash -euo pipefail

source script/timecode.sh

function main {
    if [[ $# -lt 1 ]]; then
        echo "Usage: carve <video_file>" >&2
        exit 1
    fi

    local video_path="$1"
    if [[ ! -f "$video_path" ]]; then
        echo "File not found: $video_path" >&2
        exit 1
    fi

    local video_file="${video_path##*/}"
    local video_name="${video_file%.*}"
    local video_ext="${video_file##*.}"
    local srt_path="videos/${video_name}.srt"
    local content_type title year season episode source_dir
    local existing_index=$(find_index_by_filename "$video_name")

    ensure_srt "$video_path" "$srt_path"

    if [[ -n "$existing_index" ]]; then
        source_dir="${existing_index%/*}"
        content_type=$(index_field "$existing_index" "type")
        title=$(index_field "$existing_index" "title")
        year=$(index_field "$existing_index" "year")
        echo "Found existing source: $source_dir"
        echo "Type: $content_type"
        echo "Title: $title"
        echo ""
    else
        local guess=$(guess_video_type "$video_path")
        eval "$guess"
        content_type=$(gum choose --selected="$type" "movie" "tv" "youtube")
        echo "Type: $content_type"
        title=$(prompt_input "Title" "${title:-}")

        case "$content_type" in
            movie)
                year=$(prompt_input "Year" "${year:-}")
                ;;
            tv)
                season=$(prompt_input "Season" "${season:-}")
                episode=$(prompt_input "Episode" "${episode:-}")
                ;;
        esac

        source_dir=$(get_source_dir "$content_type" "$title" "${season:-}" "${episode:-}")
        ensure_index "$source_dir" "$content_type" "$title" "$video_name" \
            "${year:-}" "${season:-}" "${episode:-}"
        echo ""
    fi

    while true; do
        local mode=$(gum choose "timecode" "subtitle" "quit")

        case "$mode" in
            quit|"")
                break
                ;;
            timecode)
                create_from_timecode "$video_name" "$video_ext" "$srt_path" \
                    "$source_dir" "$content_type"
                echo ""
                ;;
            subtitle)
                create_from_subtitle "$video_name" "$video_ext" "$srt_path" \
                    "$source_dir" "$content_type"
                echo ""
                ;;
        esac
    done
}

function prompt_input {
    local prompt="$1"
    local value="${2:-}"
    local placeholder="${3:-}"
    local width=$(($(tput cols) - ${#prompt} - 4))
    local result=$(
        gum input --prompt "$prompt: " --width "$width" \
            --value="$value" --placeholder="$placeholder"
    )

    [[ -n "$result" ]] \
        && echo "$prompt: $result" >&2
    echo "$result"
}

function ensure_srt {
    local video_path="$1"
    local srt_path="$2"

    [[ -f "$srt_path" ]] \
        && return

    echo "Extracting subtitles..."
    ffmpeg -i "$video_path" -map 0:s:0 "$srt_path" 2>/dev/null \
        || echo "No embedded subtitles found" >&2
}

function get_source_dir {
    local content_type="$1"
    local title="$2"
    local season="${3:-}"
    local episode="${4:-}"
    local slug=$(slugify "$title")
    local ep_slug

    case "$content_type" in
        movie|youtube)
            echo "source/$slug"
            ;;
        tv)
            ep_slug=$(printf "s%02de%02d" "$season" "$episode")
            echo "source/$slug/$ep_slug"
            ;;
        *)
            echo "source/$slug"
            ;;
    esac
}

function find_template {
    local dir="$1"
    local template_name="$2"

    while [[ "$dir" != "source" && "$dir" != "." ]]; do
        if [[ -f "$dir/$template_name" ]]; then
            echo "$dir/$template_name"
            return
        fi
        dir="${dir%/*}"
    done

    if [[ -f "source/$template_name" ]]; then
        echo "source/$template_name"
    fi
}

function find_index_by_filename {
    local video_name="$1"

    rg -l "^original_filename = '$video_name'" -g 'index.markdown' source/ 2>/dev/null \
        | head -1
}

function index_field {
    local file="$1"
    local key="$2"

    sed -n '/^```$/,/^```$/p' "$file" \
        | sed '1d;$d' \
        | bin/toml - "$key"
}

function ensure_index {
    local source_dir="$1"
    local content_type="$2"
    local title="$3"
    local original_filename="$4"
    local year="${5:-}"
    local season="${6:-}"
    local episode="${7:-}"
    local index_file="$source_dir/index.markdown"
    local rel_path="${source_dir#source/}"

    mkdir -p "$source_dir"

    [[ -f "$index_file" ]] \
        && return

    case "$content_type" in
        movie)
            sed -e 's/^                //' > "$index_file" <<-EOF
                \`\`\`
                title = '$title'
                year = '$year'
                type = 'movie'
                source = true
                original_filename = '$original_filename'
                \`\`\`

                WRITE ME.
			EOF
            ;;
        tv)
            sed -e 's/^                //' > "$index_file" <<-EOF
                \`\`\`
                title = '$title'
                type = 'tv-episode'
                show_fkey = '${rel_path%%/*}/index'
                season = $season
                episode = $episode
                \`\`\`

                WRITE ME.
			EOF
            ;;
        *)
            sed -e 's/^                //' > "$index_file" <<-EOF
                \`\`\`
                title = '$title'
                type = '$content_type'
                source = true
                original_filename = '$original_filename'
                \`\`\`

                WRITE ME.
			EOF
            ;;
    esac

    echo "Created $index_file"
}

function create_from_timecode {
    local video_name="$1"
    local video_ext="$2"
    local srt_path="$3"
    local source_dir="$4"
    local content_type="$5"
    local start duration_input end duration

    start=$(prompt_input "Start time" "" "1:15:35, 1h15m")
    [[ -z "$start" ]] \
        && return
    start=$(normalise_timecode "$start") \
        || return

    duration_input=$(prompt_input "End or duration" "" "5s or 1:15:40")
    [[ -z "$duration_input" ]] \
        && return

    if is_relative_duration "$duration_input"; then
        duration="${duration_input%s}"
    else
        end=$(normalise_timecode "$duration_input") \
            || return
        duration=$(calc_duration "$start" "$end")
    fi

    local gif_title=$(prompt_input "GIF title")
    [[ -z "$gif_title" ]] \
        && return
    local gif_slug=$(slugify "$gif_title")

    create_toml "$source_dir" "$gif_slug" "$gif_title" \
        "$video_name" "$video_ext" \
        "$start" "$duration" "" "$content_type"
}

function create_from_subtitle {
    local video_name="$1"
    local video_ext="$2"
    local srt_path="$3"
    local source_dir="$4"
    local content_type="$5"
    local all_subs selected selected_num range first_line
    local start_line end_line start_time end_time

    if [[ ! -f "$srt_path" ]]; then
        echo "No subtitle file available" >&2
        return
    fi

    all_subs=$(parse_srt "$srt_path")
    selected=$(echo "$all_subs" | gum filter --placeholder "Search subtitles..." || true)

    [[ -z "$selected" ]] \
        && return

    selected_num=$(echo "$selected" | cut -d'|' -f1)
    first_line=$((selected_num - 4))
    [[ $first_line -lt 1 ]] \
        && first_line=1

    echo "$all_subs" \
        | awk -F'|' -v sel="$selected_num" -v first="$first_line" '
            $1 >= first && $1 <= first+8 {
                display_num = $1 - first + 1
                prefix = ($1 == sel) ? ">" : " "
                printf "%s %d: [%s] %s\n", prefix, display_num, $2, $4
            }
        '
    echo ""

    range=$(prompt_input "Line range" "5" "1-9 or 3-7")
    [[ -z "$range" ]] \
        && return

    if [[ "$range" =~ - ]]; then
        start_line=$((${range%-*} + first_line - 1))
        end_line=$((${range#*-} + first_line - 1))
    else
        start_line=$((range + first_line - 1))
        end_line=$start_line
    fi

    start_time=$(
        echo "$all_subs" \
            | awk -F'|' -v line="$start_line" '$1 == line {print $2}'
    )
    end_time=$(
        echo "$all_subs" \
            | awk -F'|' -v line="$end_line" '$1 == line {print $3}'
    )
    start_time=$(adjust_timecode "$start_time" -0.25)
    end_time=$(adjust_timecode "$end_time" 0.25)

    local duration=$(calc_duration "$start_time" "$end_time")
    local captions=$(
        echo "$all_subs" \
            | awk -F'|' -v start="$start_line" -v end="$end_line" '
                $1 >= start && $1 <= end {
                    print $2 "|" $3 "|" $4
                }
            '
    )
    local default_title=$(echo "$selected" | cut -d'|' -f4)
    local gif_title=$(prompt_input "GIF title" "$default_title")
    [[ -z "$gif_title" ]] \
        && return
    local gif_slug=$(slugify "$gif_title")

    create_toml "$source_dir" "$gif_slug" "$gif_title" \
        "$video_name" "$video_ext" \
        "$start_time" "$duration" "$captions" "$content_type"
}

function create_toml {
    local source_dir="$1"
    local slug="$2"
    local title="$3"
    local video_name="$4"
    local video_ext="$5"
    local start="$6"
    local duration="$7"
    local captions="$8"
    local content_type="$9"
    local toml_path="$source_dir/$slug.toml"
    local rel_path="${source_dir#source/}"
    local template=$(find_template "$source_dir" "gif.template")
    local fkey_lines clip_start_secs from to

    if [[ -z "$template" ]]; then
        echo "No gif.template found" >&2
        return 1
    fi

    case "$content_type" in
        movie|youtube)
            fkey_lines="source_fkey = '$rel_path/index'"
            ;;
        tv)
            fkey_lines=$(sed -e 's/^                //' <<-EOF
                show_fkey = '${rel_path%%/*}/index'
                episode_fkey = '$rel_path/index'
			EOF
            )
            ;;
    esac

    TITLE="$title" \
    VIDEO_FILE="$video_name" \
    VIDEO_EXT="$video_ext" \
    START="$start" \
    DURATION="$duration" \
    SOURCE_FKEY="$fkey_lines" \
        envsubst < "$template" \
            > "$toml_path"

    if [[ -n "$captions" ]]; then
        clip_start_secs=$(timecode_to_seconds "$start")

        echo "$captions" | while IFS='|' read -r cap_start cap_end cap_text; do
            from=$(
                dc -e "3k $(timecode_to_seconds "$cap_start") $clip_start_secs - p" \
                    | sed 's/^\./0./'
            )
            to=$(
                dc -e "3k $(timecode_to_seconds "$cap_end") $clip_start_secs - p" \
                    | sed 's/^\./0./'
            )

            sed -e 's/^                //' >> "$toml_path" <<-EOF

                [[caption]]
                text = "$cap_text"
                from = '$from'
                to   = '$to'
			EOF
        done
    fi

    echo "Created $toml_path"
}

function slugify {
    echo "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | tr -d "'" \
        | tr -cs '[:alnum:]' '-' \
        | sed -e 's/^-*//' -e 's/-*$//' -e 's/--*/-/g'
}

function parse_srt {
    local file="$1"

    tr -d '\r' < "$file" | awk '
        /^[0-9]+$/ {
            if (num && text) {
                print num "|" start "|" end "|" text
            }
            num = $0
            text = ""
            next
        }
        /-->/ {
            split($0, times, " --> ")
            start = times[1]
            end = times[2]
            next
        }
        /^$/ { next }
        {
            if (text) text = text " " $0
            else text = $0
        }
        END {
            if (num && text) {
                print num "|" start "|" end "|" text
            }
        }
    '
}

function guess_video_type {
    local input="$1"

    # HU2ftCitvyQ.mp4; Some Video Title [HU2ftCitvyQ].mp4
    if [[ "$input" =~ (^|/)((.+)\ \[)?([A-Za-z0-9_-]{11})\]?\.[^.]+$ ]]; then
        echo "type=youtube"
        [[ -n "${BASH_REMATCH[3]}" ]] && echo "title='${BASH_REMATCH[3]}'"
        echo "video_id=${BASH_REMATCH[4]}"
        return
    fi

    # Breaking.Bad.S02E10.mkv; Firefly.1x05.mkv; Invader Zim/Season 1/05 - Episode.m4v
    if [[ "$input" =~ ^(.*)[./_][Ss]?(eason\ )?([0-9]+)[Eex/]([0-9]+) ]]; then
        local show="${BASH_REMATCH[1]##*/}"
        local season="${BASH_REMATCH[3]#0}"
        local episode="${BASH_REMATCH[4]#0}"
        show="${show//./ }"
        echo "type=tv"
        echo "title='$show'"
        echo "season=$season"
        echo "episode=$episode"
        return
    fi

    # Back.to.the.Future.1985.2160p.UHD.BluRay.mkv
    if [[ "$input" =~ ^(.*)[./_](19[0-9]{2}|20[0-9]{2})[._] ]]; then
        local title="${BASH_REMATCH[1]##*/}"
        local year="${BASH_REMATCH[2]}"
        title="${title//./ }"
        echo "type=movie"
        echo "title='$title'"
        echo "year=$year"
        return
    fi

    [[ "$input" =~ /?([^/]+)\.[^.]+$ ]]
    echo "type=unknown"
    echo "title='${BASH_REMATCH[1]}'"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
