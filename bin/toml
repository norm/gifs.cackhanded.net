#!/usr/bin/env -S bash -euo pipefail

file="$1"
key="$2"
index="${3:-}"

function query {
    local expr="$1"

    if [[ "$file" == "-" ]]; then
        yq -p toml -oy "$expr" 2>/dev/null
    else
        yq -p toml -oy "$expr" "$file" 2>/dev/null
    fi
}

if [[ "$index" == "--length" ]]; then
    result=$(query ".${key} | length") || echo 0
    [[ -n "$result" ]] && echo "$result"
else
    if [[ -n "$index" ]]; then
        array_path="${key%.*}"
        field="${key##*.}"
        result=$(query ".${array_path}[$((index-1))].${field}") || true
    else
        result=$(query ".${key}" | sed -e "s/^- //" -e "s/^'//" -e "s/'$//") || true
    fi

    [[ "$result" == "null" || -z "$result" ]] && echo "" || echo "$result"
fi
