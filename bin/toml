#!/usr/bin/env -S bash -euo pipefail

file="$1"
key="$2"
index="${3:-}"

if [[ "$index" == "--length" ]]; then
    result=$(yq -p toml -oy ".${key} | length" "$file" 2>/dev/null) || echo 0
    [[ -n "$result" ]] && echo "$result"
else
    if [[ -n "$index" ]]; then
        array_path="${key%.*}"
        field="${key##*.}"
        result=$(yq -p toml -oy ".${array_path}[$((index-1))].${field}" "$file" 2>/dev/null) || true
    else
        result=$(yq -p toml -oy ".${key}" "$file" 2>/dev/null | sed -e "s/^- //" -e "s/^'//" -e "s/'$//") || true
    fi

    [[ "$result" == "null" || -z "$result" ]] && echo "" || echo "$result"
fi
