#!/bin/bash

set -eu

export AV_LOG_FORCE_NOCOLOR=1

DEFAULT_WIDTH=480
DEFAULT_FPS=10
DEFAULT_COLOURS=64
DEBUG="${GIF_DEBUG:-}"
TYPE_SETS="${GIF_TYPE_SETS:-source/_site.toml}"
video=""
green=$'\e'[32m
cyan=$'\e'[36m
magenta=$'\e'[35m
reset=$'\e'[0m


function main {
    local toml="$1"
    local gif="$2"
    local source_video="${3:-$(video_path $toml)}"

    if [ ! -f "$source_video" ]; then
        echo " ** $source_video does not exist"
        exit 1
    fi

    duration=$(get_duration "$source_video")

    local start_seconds=0
    local start=$(toml $toml video.start)
    if [ -n "$start" ]; then
        start_seconds=$(to_seconds "$start")
        check_time "video.start" "$start_seconds"
    fi
    local toml_duration=$(toml $toml video.duration)
    if [ -n "$toml_duration" ]; then
        check_time "video end" $(( ${start_seconds%.*} + ${toml_duration%.*} ))
    fi
    local end=$(toml $toml video.end)
    if [ -n "$end" ]; then
        check_time "video end" $(( ${start_seconds%.*} + ${end%.*} ))
    fi

    local num_clips="$(toml $toml clip --length)"
    for index in $(seq 1 $num_clips); do
        check_time "clip $index" "$(to_seconds "$(toml $toml clip.end $index)")"
    done

    video="$(extract_segment "$toml" "$source_video")"
    tiled="$(create_tiled_image "$video")"
    frame_count=$(
        ffprobe -v error -count_frames -select_streams v:0 \
            -show_entries stream=nb_read_frames -of csv=p=0 "$video"
    )

    # get dimensions from processed segment
    output_width=$(
        ffprobe -v error -select_streams v:0 \
            -show_entries stream=width -of csv=p=0 "$video"
    )
    output_height=$(
        ffprobe -v error -select_streams v:0 \
            -show_entries stream=height -of csv=p=0 "$video"
    )
    echo "    ${output_width}x${output_height}" \
        $(get_dither $toml | sed -e 's/bayer://') \
        $(get_denoise $toml | sed -e 's/hqdn3d/denoise/') \
        $(get_slowdown $toml | sed -e 's/setpts=/slowdown=/' -e 's/*PTS//') \
        $(get_fps $toml | sed -e 's/^$/fps=original/')


    # create captions
    num_captions="$(toml $toml caption --length)"
    caption_args=''
    caption_colours=''
    if [ "$num_captions" -gt 0 ]; then
        for index in $(seq 1 $num_captions); do
            caption_text="$(toml $toml caption.text $index)"
            caption_placement="$(get_caption_key $toml $index placement)"
            caption_size="$(get_caption_key $toml $index size)"
            caption_margin="$(get_caption_key $toml $index margin)"
            caption_font="$(get_caption_key $toml $index font)"
            caption_colour="$(get_caption_key $toml $index colour)"
            caption_strokew="$(get_caption_key $toml $index stroke_width)"
            caption_strokecol="$(get_caption_key $toml $index stroke_colour)"
            caption_align="$(get_caption_key $toml $index align)"
            debug caption \
                ${output_width:-$DEFAULT_WIDTH} \
                $output_height \
                --colour "${caption_colour:-#ffffff}" \
                --font "${caption_font:-assistant-semibold.ttf}" \
                --font-size "${caption_size:-40}" \
                --margin "${caption_margin:-10}" \
                --stroke-width "${caption_strokew:-2}" \
                --stroke-colour "${caption_strokecol:-#000000}" \
                --text-align "${caption_align:-left}" \
                --placement ${caption_placement:-bl} \
                "${caption_text}" \
                "${TEMP}/caption-${index}.png"

            caption_colours+="--range ${caption_colour:-#ffffff} "
            caption_colours+="${caption_strokecol:-#000000} "

            caption_args+=" -i ${TEMP}/caption-${index}.png"
        done
    fi

    list_palette=''
    [ -n "$(toml $toml palette.list)" ] && \
        list_palette='--list'

    palette_add=''
    for colour in $(toml $toml palette.add); do
        palette_add+="--add $colour "
    done

    weighted_frames="$(toml $toml palette.weighted_frames)"
    rescue="$(toml $toml palette.rescue)"

    output_colours="$(toml $toml output.colours)"

    local cache_dir=$(dirname "$tiled")
    local palette_hash=$(
        echo -n "${tiled}${output_colours}${weighted_frames}${rescue}${caption_colours}${palette_add}" \
            | shasum | cut -c1-12
    )
    local palette_path="${cache_dir}/palette.${palette_hash}.png"

    if [ ! -f "$palette_path" ]; then
        debug palette \
            "$tiled" \
            "$palette_path" \
            --colours "${output_colours:-$DEFAULT_COLOURS}" \
            --frame-count "$frame_count" \
            ${weighted_frames:+--weighted-frames "$weighted_frames"} \
            ${rescue:+--rescue "$rescue"} \
            $caption_colours \
            $palette_add \
            $list_palette
    fi

    [ -n "$(toml $toml palette.show)" ] && \
        open "$palette_path"

    # first-pass stabilisation
    local stabilise="$(get_stabilise $toml)"
    if [ -n "$stabilise" ]; then
        debug ffmpeg \
            -loglevel error \
            -i "$video" \
            -vf vidstabdetect=shakiness=10:accuracy=15 \
            -f null -
    fi

    filter_debug "$(generate_filter $toml)"
    debug ffmpeg \
        -loglevel error \
        -y \
        -i "$video" \
        -i "$palette_path" \
        ${caption_args} \
        -f gif \
        -filter_complex "$(generate_filter $toml)" \
        "${TEMP}/output.gif"

    gif_duration=$(
        printf '%.2f' $(
        ffprobe \
            -v error \
            -show_entries format=duration \
            -of default=noprint_wrappers=1:nokey=1 \
                "${TEMP}/output.gif"
        )
    )
    uncompressed_size="$(filesize "${TEMP}/output.gif")"
    output_max_size="$(convert_mb $(toml $toml output.max_size))"

    printf '    size %.2fmb (duration %s)' \
        $(size_in_mb $uncompressed_size) \
        $gif_duration

    auto_max_size=$(
        printf '%.0f' "$(echo "$gif_duration .45 1048576 * * p" | dc)"
    )
    [ "${output_max_size:-}" = "auto" ] && \
        output_max_size=$auto_max_size

    indicator="$cyan"
    if [ -n "$output_max_size" ]; then
        [ "$uncompressed_size" -lt "$output_max_size" ] \
            && indicator="$green" \
            || indicator="$magenta"
    fi
    [ -n "$output_max_size" ] && \
        printf ', %smax_size %.2fmb%s' \
            $indicator \
            $(size_in_mb $output_max_size) \
            $reset

    [ "$uncompressed_size" -lt "$auto_max_size" ] \
            && indicator="$green" \
            || indicator="$magenta"
    printf ' %s[auto max %.2fmb]%s\n' \
        $indicator \
        $(size_in_mb $auto_max_size) \
        $reset

    output_loss="$(toml $toml output.loss)"
    losses="${output_loss:-0}"

    if [ "$losses" != 'no' ]; then
        gifsicle \
            -O3 \
            --lossy=$losses \
            --no-extensions \
            -o "${TEMP}/gifsicle.${losses}.gif" \
            "$TEMP/output.gif"

        size="$(filesize "${TEMP}/gifsicle.${losses}.gif")"
        indicator="$cyan"
        if [ -n "$output_max_size" ]; then
            [ "$size" -lt "$output_max_size" ] \
                && indicator="$green" \
                || indicator="$magenta"
        fi
        printf "  %s< optimised with loss %d, now %.02fmb, %.01f%% of original%s\n" \
            $indicator \
            $losses \
            $(size_in_mb $size) \
            "$(echo 3k $size $uncompressed_size / 100 \* p | dc)" \
            $reset

        if [ -n "$output_max_size" ]; then
            until [ "$size" -lt "$output_max_size" ]; do
                let "losses = losses + 10"

                gifsicle \
                    -O3 \
                    --lossy=$losses \
                    --no-extensions \
                    -o "${TEMP}/gifsicle.${losses}.gif" \
                    "$TEMP/output.gif"

                size="$(filesize "${TEMP}/gifsicle.${losses}.gif")"
                [ "$size" -lt "$output_max_size" ] \
                    && indicator="$green" \
                    || indicator="$magenta"
                printf "  %s< optimised with loss %d, now %.02fmb, %.01f%% of max%s\n" \
                    $indicator \
                    $losses \
                    $(size_in_mb $size) \
                    "$(echo 3k $size $output_max_size / 100 \* p | dc)" \
                    $reset
            done
        fi
    else
        cp "$TEMP/output.gif" "${TEMP}/gifsicle.${losses}.gif"
    fi

    ./script/gif_info "$TEMP/gifsicle.${losses}.gif" "$toml"

    mv "$TEMP/gifsicle.${losses}.gif" "$gif"

    local bytes=$(stat -f'%z' "$gif")
    local frames=$(toml $toml info.frames)
    local colours=$(toml $toml info.colours)
    echo "  = ${bytes}, ${frames} frames, ${colours} colours, ${gif}"
}

function extract_segment {
    local toml="$1"
    local source_video="$2"

    local file=$(toml $toml video.file)
    local ext=$(toml $toml video.ext)
    local hash=$(segment_hash "$toml" "$source_video")
    local cache_dir="/tmp/make_gif/${file}"
    local segment="${cache_dir}/segment.${hash}.${ext}"

    if [ -f "$segment" ]; then
        echo "$segment"
        return
    fi

    mkdir -p "$cache_dir"

    local vf="$(segment_filter "$toml" "$source_video")"
    local temp_segment="${cache_dir}/segment.${hash}.$$.${ext}"

    local num_clips="$(toml $toml clip --length)"
    if [ "$num_clips" -gt 0 ]; then
        # extract and concatenate clips, then apply visual filters
        local filter=""
        local inputs=""
        for index in $(seq 1 $num_clips); do
            local start="$(toml $toml clip.start $index)"
            local end="$(toml $toml clip.end $index)"
            filter+="[0:v]trim=start=$(to_seconds $start):end=$(to_seconds $end),setpts=PTS-STARTPTS[c${index}];"
            inputs+="[c${index}]"
        done
        filter+="${inputs}concat=n=${num_clips}:v=1[concat]"
        [ -n "$vf" ] \
            && filter+=";[concat]${vf}[out]" \
            || filter+=";[concat]copy[out]"

        local video_start=$(toml $toml video.start)
        local timing_args=""
        [ -n "$video_start" ] && timing_args="-ss $video_start"

        debug ffmpeg \
            -loglevel error \
            -y \
            $timing_args \
            -i "$source_video" \
            -filter_complex "$filter" \
            -map "[out]" \
            "$temp_segment"
    else
        # simple timing extraction with visual filters
        local timing_args=""
        local start=$(toml $toml video.start)
        [ -n "$start" ] && timing_args+=" -ss $start"
        local toml_duration=$(toml $toml video.duration)
        [ -n "$toml_duration" ] && timing_args+=" -t $toml_duration"
        local end=$(toml $toml video.end)
        [ -n "$end" ] && timing_args+=" -to $end"

        local vf_args=""
        [ -n "$vf" ] && vf_args="-vf $vf"

        debug ffmpeg \
            -loglevel error \
            -y \
            $timing_args \
            -i "$source_video" \
            $vf_args \
            "$temp_segment"
    fi

    mv "$temp_segment" "$segment"
    echo "    segment cached $segment" >&2

    echo "$segment"
}

function create_tiled_image {
    local segment="$1"

    local cache_dir=$(dirname "$segment")
    local segment_base=$(basename "$segment")
    local hash=${segment_base#segment.}
    hash=${hash%.*}
    local tiled="${cache_dir}/tiled.${hash}.png"

    if [ ! -f "$tiled" ]; then
        local frame_count=$(
            ffprobe -v error -count_frames -select_streams v:0 \
                -show_entries stream=nb_read_frames -of csv=p=0 "$segment"
        )
        local grid_size=$(echo "10k ${frame_count} v .9999 + 0k 1 / p" | dc)
        local temp_tiled="${cache_dir}/tiled.${hash}.$$.png"

        debug ffmpeg \
            -loglevel error \
            -y \
            -i "$segment" \
            -vf "format=rgba,tile=${grid_size}x${grid_size}:color=#00000000" \
            "$temp_tiled"

        mv "$temp_tiled" "$tiled"
        echo "    tiled cached $tiled" >&2
    fi

    echo "$tiled"
}

function segment_filter {
    local toml="$1"
    local source_video="$2"

    local tonemap=$(get_tonemap "$source_video")
    local fps=$(get_fps $toml)
    local crop=$(get_crop $toml)
    local scale=$(get_scale $toml)
    local bright=$(get_bright $toml)
    local denoise=$(get_denoise $toml)

    join ',' $tonemap $fps $crop $scale $bright $denoise
}

function generate_filter {
    local toml="$1"

    local dither=$(get_dither $toml)
    local paletteuse="[1:v] paletteuse=${dither}:diff_mode=rectangle"
    local captions=$(get_captions_filter $toml)
    local stabilise=$(get_stabilise $toml)
    local slowdown="$(get_slowdown $toml)"
    local alter="$(join ',' $stabilise $slowdown)"
    alter="${alter:-copy}"

    echo "[0:v] $alter [iv]; [iv]${captions}${paletteuse}"
}

function get_crop {
    local toml="$1"

    local video_crop="$(toml $toml video.crop)"
    local crop=''
    [ -n "$video_crop" ] && crop="crop=${video_crop}"

    echo $crop
}

function get_stabilise {
    local toml="$1"

    local output_stabilise="$(toml $toml output.stabilise)"
    if [ -n "$output_stabilise" ]; then
        case "$output_stabilise" in
            static)     echo "vidstabtransform=smoothing=0"
                        ;;
            *)          echo "vidstabtransform=smoothing=$output_stabilise"
                        ;;
        esac
    fi
}

function get_fps {
    local toml="$1"

    local output_fps="$(toml $toml output.fps)"
    local fps="fps=${output_fps:-$DEFAULT_FPS}"
    [ "$output_fps" == 'original' ] && fps=''

    echo $fps
}

function get_bright {
    local toml="$1"

    local output_bright="$(toml $toml output.brightness)"
    [ -n "$output_bright" ] && \
        echo "eq=brightness=$output_bright"
}

function get_denoise {
    local toml="$1"

    local output_denoise="$(toml $toml output.denoise)"
    [ -n "$output_denoise" ] && \
        echo "hqdn3d"
}

function get_scale {
    local toml="$1"

    local output_width="$(toml $toml output.width)"
    local scale="scale=${output_width:-$DEFAULT_WIDTH}:-2"
    [ "$output_width" == 'original' ] && scale=''

    echo $scale
}

function get_dither {
    local toml="$1"

    local output_dither="$(toml $toml output.dither)"

    echo "dither=${output_dither:-bayer:bayer_scale=4}"
}

function get_slowdown {
    local toml="$1"

    local output_slowdown="$(toml $toml output.slowdown)"

    [ -n "$output_slowdown" ] && \
        echo "setpts=${output_slowdown}*PTS"
}

function get_captions_filter {
    local toml="$1"

    local captions=''
    local num_captions="$(toml $toml caption --length)"
    local input
    if [ "$num_captions" -gt 0 ]; then
        for index in $(seq 1 $num_captions); do
            let "input = index + 1"

            local caption_from="$(toml $toml caption.from $index)"
            local caption_to="$(toml $toml caption.to $index)"
            local position="(main_w-overlay_w):(main_h-overlay_h)"
            local timing="${caption_from:-0},${caption_to:-1000}"
            local overlay="overlay=${position}:enable='between(t,${timing})'"

            if [ $index = 1 ]; then
                captions+="[$input:v] ${overlay} [v$index];"
            else
                captions+=" [v$((index-1))][$input:v] ${overlay} [v$index];"
            fi
        done
        captions+=" [v$index]"
    fi

    echo $captions
}

function get_tonemap {
    local source="${1:-$video}"
    if [ ! -f "$source" ]; then
        echo "get_tonemap: $source does not exist" >&2
        return 1
    fi
    local transfer=$(
        ffprobe \
            -v error \
            -select_streams v:0 \
            -show_entries stream=color_transfer \
            -of default=noprint_wrappers=1:nokey=1 \
                "$source"
    )

    if [ "$transfer" = "smpte2084" ]; then
        # convert HDR's perceptual curve to linear light
        local tonemap="zscale=t=linear:npl=100,"
        # use 32-bit float to avoid banding during conversion
        tonemap+="format=gbrpf32le,"
        # shrink HDR's wide colour gamut to SDR's narrower gamut
        tonemap+="zscale=p=bt709,"
        # compress bright highlights smoothly (Hable curve)
        tonemap+="tonemap=hable:desat=0,"
        # convert linear back to SDR gamma, set encoding, limit range
        tonemap+="zscale=t=bt709:m=bt709:r=tv,"
        # back to 8-bit for GIF processing
        tonemap+="format=yuv420p"
        echo "$tonemap"
    fi
}

function get_caption_key {
    local toml="$1"
    local index="$2"
    local key="$3"

    local set="$(toml $toml caption.type $index)"
    local set_value="$(toml $TYPE_SETS type_set.$set.$key)"
    local value="$(toml $toml caption.$key $index)"

    [ -n "$value" ] \
        && echo "$value" \
        || echo "$set_value"
}

function segment_hash {
    local toml="$1"
    local source_video="$2"
    local params=""

    # timing
    params+="$(toml $toml video.start)"
    params+="$(toml $toml video.duration)"
    params+="$(toml $toml video.end)"
    local num_clips="$(toml $toml clip --length)"
    for index in $(seq 1 $num_clips); do
        params+="$(toml $toml clip.start $index)"
        params+="$(toml $toml clip.end $index)"
    done
    # visual transformations
    params+="$(get_tonemap "$source_video")"
    params+="$(toml $toml output.fps)"
    params+="$(toml $toml video.crop)"
    params+="$(toml $toml output.width)"
    params+="$(toml $toml output.brightness)"
    params+="$(toml $toml output.denoise)"

    echo -n "$params" | shasum | cut -c1-12
}

function size_in_mb {
    local bytes="$1"
    echo "$(echo 4k $bytes 1048576 / p | dc)"
}

function get_duration {
    local duration=$(
        ffprobe \
            -v error \
            -show_entries format=duration \
            -of default=noprint_wrappers=1:nokey=1 \
                "$1"
    )
    echo ${duration%.*}
}

function video_path {
    local toml="$1"

    local file=$(toml $toml video.file)
    local ext=$(toml $toml video.ext)
    echo "videos/${file}.${ext}"
}

function convert_mb {
    size="${1:-0}"

    case "$size" in
        *mb)
            echo "${size%%mb} 1024 1024 * * p" | dc | sed -e 's/\..*//'
            ;;
        0)
            echo ''
            ;;
        *)
            echo "$size"
            ;;
    esac
}

function debug {
    [ -n "$DEBUG" ] && echo "$@" >&2
    "$@"
}

function filter_debug {
    if [ -n "$DEBUG" ]; then
        echo "$@" | sed -e 's/; */;/g' | tr ';' '\n'
    fi
}

function join {
    local IFS="$1";
    shift;
    echo "$*" | tr -s ',' | sed -e 's/^,//' -e 's/,$//'
}

function cleanup {
    rm -rf "$TEMP"
}

function filesize {
    perl -E 'say((stat($ARGV[0]))[7])' "$1"
}

function check_time {
    local label="$1"
    local seconds="$2"

    if [[ ${seconds%.*} -gt $duration ]]; then
        echo " ** $label ends after video (${seconds%.*} > $duration)"
        exit 1
    fi
}

if [ "$0" = "${BASH_SOURCE[0]}" ]; then
    # being called directly (rather than via 'source' in a test)
    TEMP="$(mktemp -d /tmp/make_gif.XXXXX)"
    trap cleanup EXIT

    main "$@"
fi
