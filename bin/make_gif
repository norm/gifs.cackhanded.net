#!/usr/bin/env -S bash -euo pipefail

export AV_LOG_FORCE_NOCOLOR=1

DEFAULT_WIDTH=480
DEFAULT_FPS=10
DEFAULT_COLOURS=64
DEBUG="${GIF_DEBUG:-}"
TYPE_SETS="${GIF_TYPE_SETS:-source/_site.toml}"
video=""
green=$'\e'[32m
yellow=$'\e'[33m
cyan=$'\e'[36m
magenta=$'\e'[35m
reset=$'\e'[0m


function main {
    local start_time=$EPOCHREALTIME
    local toml="$1"
    local gif="$2"

    validate_toml "$toml" \
        || exit 1

    local source_video="${3:-$(video_path $toml)}"

    if [ ! -f "$source_video" ]; then
        echo " ** $source_video does not exist"
        exit 1
    fi

    probe_video "$source_video"

    local crop_errors=$(validate_crop "$toml" "$source_width" "$source_height")
    if [[ -n "$crop_errors" ]]; then
        while IFS= read -r error; do
            echo "    ${yellow}${error}${reset}"
        done <<< "$crop_errors"
    fi

    local start_seconds=0
    local start=$(toml $toml video.start)
    if [ -n "$start" ]; then
        start_seconds=$(to_seconds "$start")
        check_time "video.start" "$start_seconds"
    fi
    local toml_duration=$(toml $toml video.duration)
    if [ -n "$toml_duration" ]; then
        check_time "video end" $(( ${start_seconds%.*} + ${toml_duration%.*} ))
    fi
    local end=$(toml $toml video.end)
    if [ -n "$end" ]; then
        check_time "video end" $(( ${start_seconds%.*} + ${end%.*} ))
    fi

    local num_clips="$(toml $toml clip --length)"
    for index in $(seq 1 $num_clips); do
        check_time "clip $index" "$(to_seconds "$(toml $toml clip.end $index)")"
    done

    video="$(extract_segment "$toml" "$source_video")"
    tiled="$(create_tiled_image "$video")"
    frame_count=$(
        ffprobe -v error -count_frames -select_streams v:0 \
            -show_entries stream=nb_read_frames -of csv=p=0 "$video"
    )

    # get dimensions from processed segment
    output_width=$(
        ffprobe -v error -select_streams v:0 \
            -show_entries stream=width -of csv=p=0 "$video"
    )
    output_height=$(
        ffprobe -v error -select_streams v:0 \
            -show_entries stream=height -of csv=p=0 "$video"
    )
    echo "    ${output_width}x${output_height}" \
        $(get_dither $toml | sed -e 's/bayer://') \
        $(get_denoise $toml | sed -e 's/hqdn3d/denoise/') \
        $(get_slowdown $toml | sed -e 's/setpts=/slowdown=/' -e 's/*PTS//') \
        $(get_fps $toml | sed -e 's/^$/fps=original/')


    # create captions
    local cache_dir=$(dirname "$video")
    num_captions="$(toml $toml caption --length)"
    caption_args=''
    caption_colours=''
    if [ "$num_captions" -gt 0 ]; then
        for index in $(seq 1 $num_captions); do
            caption_text="$(toml $toml caption.text $index)"
            caption_placement="$(get_caption_key $toml $index placement)"
            caption_size="$(get_caption_key $toml $index size)"
            caption_margin="$(get_caption_key $toml $index margin)"
            caption_font="$(get_caption_key $toml $index font)"
            caption_colour="$(get_caption_key $toml $index colour)"
            caption_strokew="$(get_caption_key $toml $index stroke_width)"
            caption_strokecol="$(get_caption_key $toml $index stroke_colour)"
            caption_align="$(get_caption_key $toml $index align)"

            local caption_hash=$(
                echo -n "${output_width}${output_height}${caption_text}${caption_placement}${caption_size}${caption_margin}${caption_font}${caption_colour}${caption_strokew}${caption_strokecol}${caption_align}" \
                    | shasum | cut -c1-12
            )
            local caption_path="${cache_dir}/caption-${index}.${caption_hash}.png"

            if [ ! -f "$caption_path" ]; then
                local temp_caption="${cache_dir}/caption-${index}.${caption_hash}.$$.png"
                debug caption \
                    ${output_width:-$DEFAULT_WIDTH} \
                    $output_height \
                    --colour "${caption_colour:-#ffffff}" \
                    --font "${caption_font:-assistant-semibold.ttf}" \
                    --font-size "${caption_size:-40}" \
                    --margin "${caption_margin:-10}" \
                    --stroke-width "${caption_strokew:-2}" \
                    --stroke-colour "${caption_strokecol:-#000000}" \
                    --text-align "${caption_align:-left}" \
                    --placement ${caption_placement:-bl} \
                    "${caption_text}" \
                    "$temp_caption"
                mv "$temp_caption" "$caption_path"
            fi

            caption_colours+="--range ${caption_colour:-#ffffff} "
            caption_colours+="${caption_strokecol:-#000000} "

            caption_args+=" -i $caption_path"
        done
    fi

    debug_enabled "$toml" timecode && \
        caption_colours+="--add #ffffff --add #000000 "
    debug_enabled "$toml" sizes && \
        caption_colours+="--add #ffff00 --add #00ffff --add #000000 "

    list_palette=''
    [ -n "$(toml $toml palette.list)" ] && \
        list_palette='--list'

    palette_add=''
    for colour in $(toml $toml palette.add); do
        palette_add+="--add $colour "
    done

    weighted_frames="$(toml $toml palette.weighted_frames)"
    rescue="$(toml $toml palette.rescue)"

    output_colours="$(toml $toml output.colours)"

    local cache_dir=$(dirname "$tiled")
    local palette_hash=$(
        echo -n "${tiled}${output_colours}${weighted_frames}${rescue}${caption_colours}${palette_add}" \
            | shasum | cut -c1-12
    )
    local palette_path="${cache_dir}/palette.${palette_hash}.png"

    if [ ! -f "$palette_path" ]; then
        local temp_palette="${cache_dir}/palette.${palette_hash}.$$.png"
        debug palette \
            "$tiled" \
            "$temp_palette" \
            --colours "${output_colours:-$DEFAULT_COLOURS}" \
            --frame-count "$frame_count" \
            ${weighted_frames:+--weighted-frames "$weighted_frames"} \
            ${rescue:+--rescue "$rescue"} \
            $caption_colours \
            $palette_add \
            $list_palette
        mv "$temp_palette" "$palette_path"
    fi

    [ -n "$(toml $toml palette.show)" ] && \
        open "$palette_path"

    # first-pass stabilisation
    local stabilise="$(get_stabilise $toml)"
    if [ -n "$stabilise" ]; then
        debug ffmpeg \
            -loglevel error \
            -i "$video" \
            -vf vidstabdetect=shakiness=10:accuracy=15 \
            -f null -
    fi

    filter_debug "$(generate_filter $toml)"
    debug ffmpeg \
        -loglevel error \
        -y \
        -i "$video" \
        -i "$palette_path" \
        ${caption_args} \
        -f gif \
        -filter_complex "$(generate_filter $toml)" \
        "${TEMP}/output.gif"

    gif_duration=$(
        printf '%.2f' $(
        ffprobe \
            -v error \
            -show_entries format=duration \
            -of default=noprint_wrappers=1:nokey=1 \
                "${TEMP}/output.gif"
        )
    )
    uncompressed_size="$(filesize "${TEMP}/output.gif")"
    output_max_size="$(convert_mb $(toml $toml output.max_size))"

    printf '    size %.2fmb (duration %s)' \
        $(size_in_mb $uncompressed_size) \
        $gif_duration

    auto_max_size=$(
        printf '%.0f' "$(echo "$gif_duration .45 1048576 * * p" | dc)"
    )
    [ "${output_max_size:-}" = "auto" ] && \
        output_max_size=$auto_max_size

    indicator="$cyan"
    if [ -n "$output_max_size" ]; then
        [ "$uncompressed_size" -lt "$output_max_size" ] \
            && indicator="$green" \
            || indicator="$magenta"
    fi
    [ -n "$output_max_size" ] && \
        printf ', %smax_size %.2fmb%s' \
            $indicator \
            $(size_in_mb $output_max_size) \
            $reset

    [ "$uncompressed_size" -lt "$auto_max_size" ] \
            && indicator="$green" \
            || indicator="$magenta"
    printf ' %s[auto max %.2fmb]%s\n' \
        $indicator \
        $(size_in_mb $auto_max_size) \
        $reset

    output_loss="$(toml $toml output.loss)"
    losses="${output_loss:-0}"

    if [ "$losses" = 'no' ] && [ -n "$output_max_size" ]; then
        echo "    ${yellow}max_size ignored, loss='no'${reset}" >&2
    fi

    if [ "$losses" != 'no' ]; then
        gifsicle \
            -O3 \
            --lossy=$losses \
            --no-extensions \
            -o "${TEMP}/gifsicle.${losses}.gif" \
            "$TEMP/output.gif"

        size="$(filesize "${TEMP}/gifsicle.${losses}.gif")"
        indicator="$cyan"
        if [ -n "$output_max_size" ]; then
            [ "$size" -lt "$output_max_size" ] \
                && indicator="$green" \
                || indicator="$magenta"
        fi
        printf "    %soptimised with loss %d, now %.02fmb, %.01f%% of original%s\n" \
            $indicator \
            $losses \
            $(size_in_mb $size) \
            "$(echo 3k $size $uncompressed_size / 100 \* p | dc)" \
            $reset

        if [ -n "$output_max_size" ]; then
            until [ "$size" -lt "$output_max_size" ]; do
                let "losses = losses + 10"

                gifsicle \
                    -O3 \
                    --lossy=$losses \
                    --no-extensions \
                    -o "${TEMP}/gifsicle.${losses}.gif" \
                    "$TEMP/output.gif"

                size="$(filesize "${TEMP}/gifsicle.${losses}.gif")"
                [ "$size" -lt "$output_max_size" ] \
                    && indicator="$green" \
                    || indicator="$magenta"
                printf "    %soptimised with loss %d, now %.02fmb, %.01f%% of max%s\n" \
                    $indicator \
                    $losses \
                    $(size_in_mb $size) \
                    "$(echo 3k $size $output_max_size / 100 \* p | dc)" \
                    $reset
            done
        fi
    else
        cp "$TEMP/output.gif" "${TEMP}/gifsicle.${losses}.gif"
    fi

    # don't rewrite TOML during creation
    "$(toml $toml draft)" != "true" && \
        ./script/gif_info "$TEMP/gifsicle.${losses}.gif" "$toml"

    mv "$TEMP/gifsicle.${losses}.gif" "$gif"

    local bytes=$(stat -f'%z' "$gif")
    local gif_info=$(gifsicle --color-info "$gif")
    local frames=$(echo "$gif_info" | head -1 | cut -d' ' -f3)
    local colours=$(
        echo "$gif_info" \
            | grep '^  [|]' \
            | cut -c4- \
            | fmt -1 \
            | grep -v : \
            | sed -e 's/^ *//' \
            | sort -u \
            | wc -l \
            | tr -d ' '
    )
    local elapsed=$(awk "BEGIN {printf \"%.1fs\", $EPOCHREALTIME - $start_time}")
    echo "  > ${elapsed}, ${bytes}, ${frames} frames, ${colours} colours, ${gif}"
}

function extract_segment {
    local toml="$1"
    local source_video="$2"

    local file=$(toml $toml video.file)
    local ext=$(toml $toml video.ext)
    local hash=$(segment_hash "$toml" "$source_video")
    local cache_dir="/tmp/make_gif/${file}"
    local segment="${cache_dir}/segment.${hash}.${ext}"

    if [ -f "$segment" ]; then
        echo "$segment"
        return
    fi

    mkdir -p "$cache_dir"

    local vf="$(segment_filter "$toml" "$source_video")"
    local temp_segment="${cache_dir}/segment.${hash}.$$.${ext}"

    local num_clips="$(toml $toml clip --length)"
    if [ "$num_clips" -gt 0 ]; then
        # extract and concatenate clips, then apply visual filters
        local filter=""
        local inputs=""
        for index in $(seq 1 $num_clips); do
            local start="$(toml $toml clip.start $index)"
            local end="$(toml $toml clip.end $index)"
            filter+="[0:v]trim=start=$(to_seconds $start):end=$(to_seconds $end),setpts=PTS-STARTPTS[c${index}];"
            inputs+="[c${index}]"
        done
        filter+="${inputs}concat=n=${num_clips}:v=1[concat]"
        [ -n "$vf" ] \
            && filter+=";[concat]${vf}[out]" \
            || filter+=";[concat]copy[out]"

        local video_start=$(toml $toml video.start)
        local timing_args=""
        [ -n "$video_start" ] && timing_args="-ss $video_start"

        debug ffmpeg \
            -loglevel error \
            -y \
            $timing_args \
            -i "$source_video" \
            -filter_complex "$filter" \
            -map "[out]" \
            "$temp_segment"
    else
        # simple timing extraction with visual filters
        local timing_args=""
        local start=$(toml $toml video.start)
        [ -n "$start" ] && timing_args+=" -ss $start"
        local toml_duration=$(toml $toml video.duration)
        [ -n "$toml_duration" ] && timing_args+=" -t $toml_duration"
        local end=$(toml $toml video.end)
        [ -n "$end" ] && timing_args+=" -to $end"

        local vf_args=""
        [ -n "$vf" ] && vf_args="-vf $vf"

        debug ffmpeg \
            -loglevel error \
            -y \
            $timing_args \
            -i "$source_video" \
            $vf_args \
            "$temp_segment"
    fi

    mv "$temp_segment" "$segment"
    echo "    video segment cached $segment" >&2

    echo "$segment"
}

function create_tiled_image {
    local segment="$1"

    local cache_dir=$(dirname "$segment")
    local segment_base=$(basename "$segment")
    local hash=${segment_base#segment.}
    hash=${hash%.*}
    local tiled="${cache_dir}/tiled.${hash}.png"

    if [ ! -f "$tiled" ]; then
        local frame_count=$(
            ffprobe -v error -count_frames -select_streams v:0 \
                -show_entries stream=nb_read_frames -of csv=p=0 "$segment"
        )
        local grid_size=$(echo "10k ${frame_count} v .9999 + 0k 1 / p" | dc)
        local temp_tiled="${cache_dir}/tiled.${hash}.$$.png"

        debug ffmpeg \
            -loglevel error \
            -y \
            -i "$segment" \
            -vf "format=rgba,tile=${grid_size}x${grid_size}:color=#00000000" \
            "$temp_tiled"

        mv "$temp_tiled" "$tiled"
        echo "    frame tiles cached $tiled" >&2
    fi

    echo "$tiled"
}

function segment_filter {
    local toml="$1"
    local source_video="$2"

    local tonemap=$(get_tonemap "$source_video")
    local fps=$(get_fps $toml)
    local crop=$(get_crop $toml)
    local scale=$(get_scale $toml)
    local bright=$(get_bright $toml)
    local denoise=$(get_denoise $toml)

    join ',' $tonemap $fps $crop $scale $bright $denoise
}

function generate_filter {
    local toml="$1"

    local dither=$(get_dither $toml)
    local paletteuse="[1:v] paletteuse=${dither}:diff_mode=rectangle"
    local captions=$(get_captions_filter $toml)
    local stabilise=$(get_stabilise $toml)
    local slowdown="$(get_slowdown $toml)"
    local grid="$(get_grid $toml)"
    local timecode="$(get_timecode $toml)"
    local alter="$(join ',' $stabilise $slowdown $grid $timecode)"
    alter="${alter:-copy}"

    echo "[0:v] $alter [iv]; [iv]${captions}${paletteuse}"
}

function get_crop_value {
    local toml="$1"

    local width="$(toml $toml video.crop.width)"
    local height="$(toml $toml video.crop.height)"
    local left="$(toml $toml video.crop.left)"
    local top="$(toml $toml video.crop.top)"

    # if no structured values, try string format
    if [[ -z "$width" && -z "$height" && -z "$left" && -z "$top" ]]; then
        toml $toml video.crop
        return
    fi

    echo "$width:$height:$left:$top"
}

function get_crop {
    local toml="$1"

    local value=$(get_crop_value "$toml")
    [[ -z "$value" ]] \
        && return

    local width height left top
    IFS=: read -r width height left top <<< "$value"

    local result="$width"
    [[ -n "$height" || -n "$left" || -n "$top" ]] \
        && result+=":$height"
    [[ -n "$left" || -n "$top" ]] \
        && result+=":$left"
    [[ -n "$top" ]] \
        && result+=":$top"

    echo "crop=$result"
}

function validate_crop {
    local toml="$1"
    local src_w="$2"
    local src_h="$3"

    local crop_value=$(get_crop_value "$toml")
    [[ -z "$crop_value" ]] \
        && return

    local width height left top
    IFS=: read -r width height left top <<< "$crop_value"

    local errors=()

    [[ -z "$width" ]] \
        && errors+=("crop requires width")
    [[ -n "$width" && "$width" -le 0 ]] \
        && errors+=("crop width must be positive")
    [[ -n "$height" && "$height" -le 0 ]] \
        && errors+=("crop height must be positive")
    [[ -n "$top" && -z "$left" ]] \
        && errors+=("crop top requires left")

    # bounds checks need valid dimensions
    if [[ -n "$width" && "$width" -gt 0 ]]; then
        [[ -z "$left" ]] \
            && left=$(( (src_w - width) / 2 ))
        [[ -z "$top" ]] \
            && top=$(( (src_h - height) / 2 ))

        local right=$((left + width))
        local bottom=$((top + height))
        [[ "$right" -gt "$src_w" ]] \
            && errors+=("crop exceeds frame width: $right > $src_w")
        [[ "$bottom" -gt "$src_h" ]] \
            && errors+=("crop exceeds frame height: $bottom > $src_h")
    fi

    printf '%s\n' "${errors[@]}"
}

function validate_toml {
    local toml="$1"

    sed 's/^        //' <<-EOF | python - "$toml"
        import sys, tomllib
        try:
            tomllib.load(open(sys.argv[1], 'rb'))
        except tomllib.TOMLDecodeError as e:
            print(f'{sys.argv[1]}: {e}')
            sys.exit(1)
	EOF
}

function get_stabilise {
    local toml="$1"

    local output_stabilise="$(toml $toml output.stabilise)"
    if [ -n "$output_stabilise" ]; then
        case "$output_stabilise" in
            static)     echo "vidstabtransform=smoothing=0"
                        ;;
            *)          echo "vidstabtransform=smoothing=$output_stabilise"
                        ;;
        esac
    fi
}

function get_fps {
    local toml="$1"

    local output_fps="$(toml $toml output.fps)"
    local fps="fps=${output_fps:-$DEFAULT_FPS}"
    [ "$output_fps" == 'original' ] && fps=''

    echo $fps
}

function get_bright {
    local toml="$1"

    local output_bright="$(toml $toml output.brightness)"
    [ -n "$output_bright" ] && \
        echo "eq=brightness=$output_bright"
}

function get_denoise {
    local toml="$1"

    local output_denoise="$(toml $toml output.denoise)"
    [ -n "$output_denoise" ] && \
        echo "hqdn3d"
}

function get_scale {
    local toml="$1"

    local output_width="$(toml $toml output.width)"
    local scale="scale=${output_width:-$DEFAULT_WIDTH}:-2"
    [ "$output_width" == 'original' ] && scale=''

    echo $scale
}

function get_dither {
    local toml="$1"

    local output_dither="$(toml $toml output.dither)"

    echo "dither=${output_dither:-bayer:bayer_scale=4}"
}

function get_slowdown {
    local toml="$1"

    local output_slowdown="$(toml $toml output.slowdown)"

    [ -n "$output_slowdown" ] && \
        echo "setpts=${output_slowdown}*PTS"
}

function get_timecode {
    local toml="$1"

    debug_enabled "$toml" timecode && \
        echo "drawtext=text='%{pts}':fontfile=fonts/spacemono-regular.ttf:x=(W/4-tw)/2:y=(H/4-th)/2:fontsize=18:fontcolor=white:box=1:boxcolor=black@0.7"
}

function get_grid {
    local toml="$1"
    local show_grid=false
    local show_sizes=false

    debug_enabled "$toml" grid && show_grid=true
    debug_enabled "$toml" sizes && show_sizes=true

    $show_grid || $show_sizes || return

    local filters=""

    if $show_grid; then
        filters="drawgrid=w=iw/4:h=ih/4:t=2:c=white@0.5"
    fi

    if $show_sizes; then
        local crop_value=$(get_crop_value $toml)
        local crop_w crop_h crop_x crop_y
        if [[ -n "$crop_value" ]]; then
            IFS=: read -r crop_w crop_h crop_x crop_y <<< "$crop_value"
            # calculate centres if not specified
            [[ -z "$crop_x" ]] && crop_x=$(( (source_width - crop_w) / 2 ))
            [[ -z "$crop_y" ]] && crop_y=$(( (source_height - crop_h) / 2 ))
        else
            crop_w=$source_width
            crop_h=$source_height
            crop_x=0
            crop_y=0
        fi

        local font="fontfile=fonts/spacemono-bold.ttf:fontsize=W/48:fontcolor=yellow:box=1:boxcolor=black@0.7"
        local wfont="fontfile=fonts/spacemono-bold.ttf:fontsize=W/48:fontcolor=cyan:box=1:boxcolor=black@0.7"
        local sep=""
        [ -n "$filters" ] && sep=","

        # X position labels (top edge) - use source coordinates
        filters+="${sep}drawtext=text='${crop_x}':${font}:x=2:y=2"
        for col in 1 2 3; do
            local x_src=$(( col * crop_w / 4 + crop_x ))
            filters+=",drawtext=text='${x_src}':${font}:x=${col}*W/4+2:y=2"
        done
        local x_end=$(( crop_w + crop_x ))
        filters+=",drawtext=text='${x_end}':${font}:x=W-tw-2:y=2"

        # Width stacks (below each column line) - use source dimensions
        for col in 1 2 3 4; do
            [ $col -eq 4 ] && x_pos="W-tw-2" || x_pos="${col}*W/4-tw-2"
            for row in $(seq 1 $col); do
                local val=$(( (col - row + 1) * crop_w / 4 ))
                [ $((col - row + 1)) -eq 4 ] && val=$crop_w
                filters+=",drawtext=text='${val}':${wfont}:x=${x_pos}:y=th*${row}+$((row*2+2))"
            done
        done

        # Y position labels (left edge) - use source coordinates
        filters+=",drawtext=text='${crop_y}':${font}:x=2:y=th+4"
        for row in 1 2 3; do
            local y_src=$(( row * crop_h / 4 + crop_y ))
            filters+=",drawtext=text='${y_src}':${font}:x=2:y=${row}*H/4+2"
        done
        local y_end=$(( crop_h + crop_y ))
        filters+=",drawtext=text='${y_end}':${font}:x=2:y=H-th-2"

        # Height stacks (above each row line) - use source dimensions
        for row in 1 2 3; do
            for idx in $(seq 1 $row); do
                local val=$(( (row - idx + 1) * crop_h / 4 ))
                [ $((row - idx + 1)) -eq 4 ] && val=$crop_h
                filters+=",drawtext=text='${val}':${wfont}:x=2:y=${row}*H/4-th*${idx}-$((idx*2))"
            done
        done
        # Bottom row (special case - offset from H not H/4)
        for idx in 1 2 3 4; do
            local val=$(( (5 - idx) * crop_h / 4 ))
            [ $((5 - idx)) -eq 4 ] && val=$crop_h
            filters+=",drawtext=text='${val}':${wfont}:x=2:y=H-th*$((idx+1))-$((idx*2+2))"
        done
    fi

    echo "$filters"
}

function get_captions_filter {
    local toml="$1"

    local captions=''
    local num_captions="$(toml $toml caption --length)"
    local input
    if [ "$num_captions" -gt 0 ]; then
        for index in $(seq 1 $num_captions); do
            let "input = index + 1"

            local caption_from="$(toml $toml caption.from $index)"
            local caption_to="$(toml $toml caption.to $index)"
            local position="(main_w-overlay_w):(main_h-overlay_h)"
            local timing="${caption_from:-0},${caption_to:-1000}"
            local overlay="overlay=${position}:enable='between(t,${timing})'"

            if [ $index = 1 ]; then
                captions+="[$input:v] ${overlay} [v$index];"
            else
                captions+=" [v$((index-1))][$input:v] ${overlay} [v$index];"
            fi
        done
        captions+=" [v$index]"
    fi

    echo $captions
}

function get_tonemap {
    local source="${1:-$video}"
    if [ ! -f "$source" ]; then
        echo "get_tonemap: $source does not exist" >&2
        return 1
    fi
    local transfer=$(
        ffprobe \
            -v error \
            -select_streams v:0 \
            -show_entries stream=color_transfer \
            -of default=noprint_wrappers=1:nokey=1 \
                "$source"
    )

    if [ "$transfer" = "smpte2084" ]; then
        # convert HDR's perceptual curve to linear light
        local tonemap="zscale=t=linear:npl=100,"
        # use 32-bit float to avoid banding during conversion
        tonemap+="format=gbrpf32le,"
        # shrink HDR's wide colour gamut to SDR's narrower gamut
        tonemap+="zscale=p=bt709,"
        # compress bright highlights smoothly (Hable curve)
        tonemap+="tonemap=hable:desat=0,"
        # convert linear back to SDR gamma, set encoding, limit range
        tonemap+="zscale=t=bt709:m=bt709:r=tv,"
        # back to 8-bit for GIF processing
        tonemap+="format=yuv420p"
        echo "$tonemap"
    fi
}

function get_caption_key {
    local toml="$1"
    local index="$2"
    local key="$3"

    local set="$(toml $toml caption.type $index)"
    local set_value="$(toml $TYPE_SETS type_set.$set.$key)"
    local value="$(toml $toml caption.$key $index)"

    [ -n "$value" ] \
        && echo "$value" \
        || echo "$set_value"
}

function segment_hash {
    local toml="$1"
    local source_video="$2"
    local params=""

    # timing
    params+="$(toml $toml video.start)"
    params+="$(toml $toml video.duration)"
    params+="$(toml $toml video.end)"
    local num_clips="$(toml $toml clip --length)"
    for index in $(seq 1 $num_clips); do
        params+="$(toml $toml clip.start $index)"
        params+="$(toml $toml clip.end $index)"
    done
    # visual transformations
    params+="$(get_tonemap "$source_video")"
    params+="$(toml $toml output.fps)"
    params+="$(get_crop_value $toml)"
    params+="$(toml $toml output.width)"
    params+="$(toml $toml output.brightness)"
    params+="$(toml $toml output.denoise)"

    echo -n "$params" | shasum | cut -c1-12
}

function size_in_mb {
    local bytes="$1"
    echo "$(echo 4k $bytes 1048576 / p | dc)"
}

function probe_video {
    local video="$1"
    local info=$(
        ffprobe -v error -select_streams v:0 \
            -show_entries stream=color_transfer,width,height:format=duration \
            -of default=noprint_wrappers=1 "$video"
    )
    source_transfer=$(echo "$info" | grep '^color_transfer=' | cut -d= -f2)
    source_width=$(echo "$info" | grep '^width=' | cut -d= -f2)
    source_height=$(echo "$info" | grep '^height=' | cut -d= -f2)
    local dur=$(echo "$info" | grep '^duration=' | cut -d= -f2)
    duration=${dur%.*}
}

function debug_enabled {
    local toml="$1"
    local feature="$2"

    [ "$(toml $toml debug)" = "true" ] && return 0
    [ "$(toml $toml debug.$feature)" = "true" ] && return 0
    return 1
}

function video_path {
    local toml="$1"

    local file=$(toml $toml video.file)
    local ext=$(toml $toml video.ext)
    echo "videos/${file}.${ext}"
}

function convert_mb {
    size="${1:-0}"

    case "$size" in
        *mb)
            echo "${size%%mb} 1024 1024 * * p" | dc | sed -e 's/\..*//'
            ;;
        0)
            echo ''
            ;;
        *)
            echo "$size"
            ;;
    esac
}

function debug {
    [ -n "$DEBUG" ] && echo "$@" >&2
    "$@"
}

function filter_debug {
    if [ -n "$DEBUG" ]; then
        echo "$@" | sed -e 's/; */;/g' | tr ';' '\n'
    fi
}

function join {
    local IFS="$1";
    shift;
    echo "$*" | tr -s ',' | sed -e 's/^,//' -e 's/,$//'
}

function cleanup {
    rm -rf "$TEMP"
}

function filesize {
    perl -E 'say((stat($ARGV[0]))[7])' "$1"
}

function check_time {
    local label="$1"
    local seconds="$2"

    if [[ ${seconds%.*} -gt $duration ]]; then
        echo " ** $label ends after video (${seconds%.*} > $duration)"
        exit 1
    fi
}

if [ "$0" = "${BASH_SOURCE[0]}" ]; then
    # being called directly (rather than via 'source' in a test)
    TEMP="$(mktemp -d /tmp/make_gif.XXXXX)"
    trap cleanup EXIT

    main "$@"
fi
