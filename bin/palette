#!/usr/bin/env python

import argparse
import math
import sys

import imagequant
from PIL import Image, ImageColor


def parse_frame_spec(spec):
    frames = set()
    for part in spec.split():
        if '-' in part:
            start, end = part.split('-', 1)
            frames.update(range(int(start), int(end) + 1))
        else:
            frames.add(int(part))
    return sorted(frames)


def weight_frames(image, frame_indices, weighting, frame_count):
    width, height = image.size
    grid_size = math.ceil(math.sqrt(frame_count))
    frame_width = width // grid_size
    frame_height = height // grid_size

    extra_frames = len(frame_indices) * (weighting - 1)
    extra_rows = (extra_frames + grid_size - 1) // grid_size
    new_height = height + extra_rows * frame_height

    new_image = Image.new('RGBA', (width, new_height))
    new_image.paste(image, (0, 0))

    dest_col = 0
    dest_row = grid_size

    for frame_idx in frame_indices:
        if frame_idx >= grid_size * grid_size:
            continue
        col = frame_idx % grid_size
        row = frame_idx // grid_size
        frame = image.crop((
            col * frame_width,
            row * frame_height,
            (col + 1) * frame_width,
            (row + 1) * frame_height,
        ))

        for copy in range(weighting - 1):
            new_image.paste(frame, (dest_col * frame_width, dest_row * frame_height))
            dest_col += 1
            if dest_col >= grid_size:
                dest_col = 0
                dest_row += 1

    return new_image


def colour_range(start, end):
    start = ImageColor.getrgb(start)
    end = ImageColor.getrgb(end)

    colours = [
        (start[0], start[1], start[2], 255),
        (end[0], end[1], end[2], 255),
    ]

    # calculate 6 colours -- the two endpoints plus four intermediates
    for step in range(4, 0, -1):
        mult = step / 5
        red = start[0] + int((end[0] - start[0]) * mult)
        green = start[1] + int((end[1] - start[1]) * mult)
        blue = start[2] + int((end[2] - start[2]) * mult)
        colours.append((red, green, blue, 255))

    return colours


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('input', help='Tiled image (frames from ffmpeg)')
    parser.add_argument('output', help='Output palette PNG (16x16)')
    parser.add_argument('--colours', type=int, default=64)
    parser.add_argument('--add', action='append', default=[],
                        help='Spot colour to add (can be repeated)')
    parser.add_argument('--range', nargs=2, action='append', default=[],
                        dest='ranges', metavar=('FROM', 'TO'),
                        help='Colour range to interpolate')
    parser.add_argument('--frame-count', type=int,
                        help='Number of frames in the tiled image')
    parser.add_argument('--weight-frames',
                        help='Frame indices to weight (e.g. "0", "0-2", "0 1 2-6")')
    parser.add_argument('--weighting', type=int, default=1,
                        help='How many times to duplicate weighted frames')
    parser.add_argument('--list', action='store_true',
                        help='Print all palette colours')
    parser.add_argument('--save-weighted',
                        help='Save the weighted image to this path')
    args = parser.parse_args()

    image = Image.open(args.input).convert('RGBA')

    if args.weight_frames and args.weighting > 1:
        frame_indices = parse_frame_spec(args.weight_frames)
        image = weight_frames(
            image,
            frame_indices,
            args.weighting,
            args.frame_count,
        )
        if args.save_weighted:
            image.save(args.save_weighted)

    quantized = imagequant.quantize_pil_image(
        image,
        dithering_level=0.0,
        max_colors=args.colours,
    )

    palette_data = quantized.getpalette()
    used_indices = set(quantized.get_flattened_data())
    colours = {
        (palette_data[i*3], palette_data[i*3+1], palette_data[i*3+2], 255)
            for i in used_indices
    }

    for colour in args.add:
        rgb = ImageColor.getrgb(colour)
        colours.add((rgb[0], rgb[1], rgb[2], 255))

    for from_colour, to_colour in args.ranges:
        for colour in colour_range(from_colour, to_colour):
            colours.add(colour)

    if len(colours) > 256:
        print(f'error: {len(colours)} colours exceeds 256 limit', file=sys.stderr)
        sys.exit(1)

    colour_list = sorted(colours)

    # 16x16 is ffmpeg's expected palette format, padding with last colour same as ffmpeg
    palette_img = Image.new('RGBA', (16, 16), colour_list[-1])
    pixels = palette_img.load()

    for i, colour in enumerate(colour_list):
        x = i % 16
        y = i // 16
        pixels[x, y] = colour

    palette_img.save(args.output)

    if args.list:
        for colour in colour_list:
            print('#%02x%02x%02x' % colour[:3])


if __name__ == '__main__':
    main()
