#!/usr/bin/env python

import argparse
import os
import sys

from PIL import Image, ImageDraw, ImageFont

MINIMUM_FONT_SIZE = 8


def position_multiline_with_anchor(
    text, placement, anchor, font, stroke_width, temp_draw, align='left'
):
    if '\n' not in text:
        return placement, anchor

    # pillow's support for anchors in multline text is lacking, so we calculate a
    # reference bounding box from a known character and extrapolate
    text_bbox = temp_draw.multiline_textbbox(
        (0, 0), text, font=font, stroke_width=stroke_width, align=align
    )

    # horizontal positioning -- reference "M""
    horizontal_bbox = temp_draw.textbbox(
        (placement[0], 0),
        "M",
        font=font,
        stroke_width=stroke_width,
        anchor=anchor,
    )

    if anchor[0] == 'r':
        # right
        new_x = horizontal_bbox[2] - text_bbox[2]
    elif anchor[0] == 'm':
        # h centre ("middle"")
        new_x = (horizontal_bbox[0] + horizontal_bbox[2]) / 2 - (text_bbox[0] + text_bbox[2]) / 2
    else:
        # left
        new_x = horizontal_bbox[0] - text_bbox[0]

    if anchor[1] == 't':
        # top
        top_bbox = temp_draw.multiline_textbbox(
            (0, placement[1]), "T",
            font=font, stroke_width=stroke_width, anchor=anchor
        )
        new_y = top_bbox[1] - text_bbox[1]
    elif anchor[1] == 'd':
        # bottom ("descender")
        modified_bbox = temp_draw.multiline_textbbox(
            (0, 0), text + 'y', font=font, stroke_width=stroke_width
        )
        bottom_bbox = temp_draw.multiline_textbbox(
            (0, placement[1]), "y",
            font=font, stroke_width=stroke_width, anchor=anchor
        )
        new_y = bottom_bbox[3] - modified_bbox[3]
    else:
        # v centre
        text_height = text_bbox[3] - text_bbox[1]
        new_y = placement[1] - (text_height / 2) - text_bbox[1]

    return [new_x, new_y], None


def main():
    parser = argparse.ArgumentParser(
        description='Create a caption image.'
    )
    parser.add_argument(
        '--margin',
        default=10,
        type=int,
    )
    parser.add_argument(
        '--font',
        default='assistant-semibold.ttf',
    )
    parser.add_argument(
        '--font-size',
        default=40,
        type=int,
    )
    parser.add_argument(
        '--colour',
        default='#ffffff',
    )
    parser.add_argument(
        '--stroke-colour',
        default='#000000',
    )
    parser.add_argument(
        '--stroke-width',
        default=2,
        type=int,
    )
    parser.add_argument(
        '--text-align',
        default='left',
    )
    parser.add_argument(
        'width',
        type=int,
    )
    parser.add_argument(
        'height',
        type=int,
    )
    parser.add_argument(
        'text',
    )
    parser.add_argument(
        'output',
    )
    parser.add_argument(
        '--placement',
        default='bl',
    )
    parser.add_argument(
        '--guides',
        action='store_true',
        help='Draw margin box and center lines',
    )
    args = parser.parse_args()
    image_size = (args.width, args.height)
    font_size = args.font_size
    font_path = 'fonts/%s' % args.font

    if not os.path.exists(font_path):
        sys.exit('Font not found: %s' % font_path)

    # Derive text alignment from placement if not explicitly set
    if args.text_align == 'left':
        if 'c' in args.placement:
            args.text_align = 'center'
        elif 'r' in args.placement:
            args.text_align = 'right'

    # check the text fits
    font = ImageFont.truetype(font_path, font_size, layout_engine=ImageFont.Layout.BASIC)
    temp_image = ImageDraw.Draw(Image.new('RGBA', (1, 1)))
    bbox = temp_image.multiline_textbbox(
        (0, 0),
        args.text,
        font=font,
        stroke_width=args.stroke_width,
        align=args.text_align,
    )
    text_size = (bbox[2] - bbox[0], bbox[3] - bbox[1])
    while text_too_large(text_size, image_size, args.margin):
        font_size -= 2
        if font_size < MINIMUM_FONT_SIZE:
            sys.exit('Text too large to fit in image at font size %s' % font_size)
        font = ImageFont.truetype(font_path, font_size, layout_engine=ImageFont.Layout.BASIC)
        temp_image = ImageDraw.Draw(Image.new('RGBA', (1, 1)))
        bbox = temp_image.multiline_textbbox(
            (0, 0),
            args.text,
            font=font,
            stroke_width=args.stroke_width,
            align=args.text_align,
        )
        text_size = (bbox[2] - bbox[0], bbox[3] - bbox[1])

    canvas = Image.new('RGBA', image_size, (0, 0, 0, 0))
    image = ImageDraw.Draw(canvas)

    if args.guides:
        image.rectangle(
            [(args.margin, args.margin),
             (image_size[0] - args.margin, image_size[1] - args.margin)],
            outline=(200, 0, 0),
            width=2
        )
        center_x = image_size[0] // 2
        center_y = image_size[1] // 2
        image.line([(center_x, 0), (center_x, image_size[1])],
                   fill=(200, 0, 0), width=1)
        image.line([(0, center_y), (image_size[0], center_y)],
                   fill=(200, 0, 0), width=1)

    left = args.margin
    hcentre = int(image_size[0] / 2)
    right = image_size[0] - args.margin

    top = args.margin
    vcentre = int(image_size[1] / 2)
    bottom = image_size[1] - args.margin

    # FIXME percentage placements?
    placement = list(image_size)

    if ',' in args.placement:
        x, y = args.placement.split(',')
        try:
            x = int(x)
            if x < 0:
                x = placement[0] + x
        except ValueError:
            pass
        try:
            y = int(y)
            if y < 0:
                y = placement[1] + y
        except ValueError:
            pass
        placement = [x, y]

    v_anchor = 'm'
    if 't' in args.placement:
        placement[1] = top
        v_anchor = 't'
    elif 'm' in args.placement:
        placement[1] = vcentre
    elif 'b' in args.placement:
        placement[1] = bottom
        v_anchor = 'd'

    h_anchor = 'l'
    if 'l' in args.placement:
        placement[0] = left
    elif 'c' in args.placement:
        placement[0] = hcentre
        h_anchor = 'm'
    elif 'r' in args.placement:
        placement[0] = right
        h_anchor = 'r'

    adjusted_placement, adjusted_anchor = position_multiline_with_anchor(
        args.text,
        placement,
        h_anchor + v_anchor,
        font,
        args.stroke_width,
        temp_image,
        args.text_align,
    )

    image.text(
        adjusted_placement,
        args.text,
        args.colour,
        font,
        stroke_fill=args.stroke_colour,
        stroke_width=args.stroke_width,
        align=args.text_align,
        anchor=adjusted_anchor,
    )
    canvas.save(args.output)

    if args.font_size > font_size:
        print('    \33[35mfont_size=%s\33[0m placement=%s %s' % (
            font_size,
            placement,
            args.text.replace("\n", "\\n")
        ))
    else:
        print('    font_size=%s placement=%s %s' % (
            font_size,
            placement,
            args.text.replace("\n", "\\n")
        ))


def text_too_large(text, image, margin):
    if text[0] + (margin * 2) > image[0]:
        return True
    if text[1] + (margin * 2) > image[1]:
        return True
    return False


if __name__ == '__main__':
    main()
